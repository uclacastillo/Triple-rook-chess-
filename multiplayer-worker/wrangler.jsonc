{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "triple-rook-multiplayer",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "exports": {
    "GameRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "FRONTEND_ORIGIN": "https://triple-rook-chess.vercel.app,https://triple-rook-chess-git-featur-1d2455-uclacastillo-2485s-projects.vercel.app"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
